    "\n",
    "    def __len__(self):\n",
    "        return len(self.texts)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "\n",
    "        x = torch.tensor(\n",
    "            encode_text(self.texts.iloc[idx]),\n",
    "            dtype=torch.long\n",
    "        )\n",
    "\n",
    "        if self.labels is not None:\n",
    "\n",
    "            y = torch.tensor(\n",
    "                self.labels[idx],\n",
    "                dtype=torch.long\n",
    "            )\n",
    "\n",
    "            return x, y\n",
    "\n",
    "        return x"
