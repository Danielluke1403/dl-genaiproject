    "def apk(actual, predicted, k=3):\n",
    "    if len(predicted) > k:\n",
    "        predicted = predicted[:k]\n",
    "\n",
    "    score = 0.0\n",
    "\n",
    "    for i, p in enumerate(predicted):\n",
    "        if p == actual:\n",
    "            score = 1.0 / (i + 1)\n",
    "            break\n",
    "\n",
    "    return score\n",
    "\n",
    "\n",
    "def mapk(actuals, predictions, k=3):\n",
    "    return np.mean([\n",
    "        apk(a, p, k)\n",
    "        for a, p in zip(actuals, predictions)\n",
    "    ])"
   ]
  },
